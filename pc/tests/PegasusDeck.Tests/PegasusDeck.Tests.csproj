<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Controles multimedia de Windows (SMTC, WinRT): Windows 10 2004 o posterior (ADR-022). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Nombres de prueba en espaÃ±ol y sin sufijo Async. -->
    <!-- IAsyncLifetime libera en DisposeAsync (CA1001); contadores públicos en dobles de prueba (CA1051). -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1001;CA1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <!-- Valida las respuestas del servicio con los esquemas de contracts/ (solo pruebas). -->
    <PackageReference Include="JsonSchema.Net" Version="7.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PegasusDeck.Core\PegasusDeck.Core.csproj" />
    <ProjectReference Include="..\..\src\PegasusDeck.Service\PegasusDeck.Service.csproj" />
    <ProjectReference Include="..\..\src\PegasusDeck.Agent\PegasusDeck.Agent.csproj" />
  </ItemGroup>
</Project>

